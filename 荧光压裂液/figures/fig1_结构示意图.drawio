          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="mech" value="功能切换机制：注入阶段(分散态) PEG外层屏蔽 → 关井破胶 PEG氧化脱附 → 暴露KH550活性-NH&lt;sub&gt;2&lt;/sub&gt; → 锚定于砂岩壁面(锚定态)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2DFDB;strokeColor=#00897B;fontSize=9;align=center;fontStyle=2;" vertex="1" parent="1">
