          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="co_peg" value="外层：PEG物理屏蔽层 (PEG4000)

- 注入阶段：空间位阻保障分散
- 破胶阶段：牺牲响应层脱附
- 暴露内层NH&lt;sub&gt;2&lt;/sub&gt;锚定位点" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=9;spacingLeft=8;spacingTop=4;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="1">
